# Copy to .env.local (ignored by git) and fill in. build.sh reads it and writes the values into the app's Info.plist.
# Leave a value empty to fall back to the credential fields in Settings. See docs/cloud-sync.md.

# Dropbox: App key of a Scoped app with App folder access (public by design, PKCE, no secret).
OVERHEARD_DROPBOX_APP_KEY=

# Google: OAuth client of type "Desktop app" with the Drive API enabled.
OVERHEARD_GOOGLE_CLIENT_ID=
OVERHEARD_GOOGLE_CLIENT_SECRET=

# Microsoft OneDrive: Application (client) ID of an app registered in Microsoft Entra
# (platform "Mobile and desktop applications", redirect http://localhost). Public client, no secret.
OVERHEARD_ONEDRIVE_CLIENT_ID=
